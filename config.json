{
  "model": {
    "latent_channels": 4,
    "hidden_dim": 256,
    "num_layers": 8,
    "num_styles": 2,
    "kernel_size": 7
  },
  "training": {
    "batch_size": 64,
    "learning_rate": 5e-5,
    "use_amp": true,
    "num_workers": 0,
    "stage1_epochs": 80,
    "stage2_epochs": 80,
    "reflow_data_dir": "data_reflow_cache",
    "monitor_every": 10,
    "eval_step": 1,
    "do_inference": true,
    "keep_vae_on_gpu": false,
    "identity_weights": [0.8,1.5],
    "stage2_init_from_stage1": true,
    "stage1_warmup_ratio": 0.1,
    "style_dropout": {
      "enabled": true,
      "p": 0.1,
      "per_sample": true
    },
    "gram_loss": {
      "enabled": false,
      "lambda": 0.1,
      "apply_on": "style_only"
    },
    "ema": {
      "enabled": false,
      "decay": 0.9
    },
    "generation_monitor": {
      "use_expected_count": true,
      "stable_seconds": 30,
      "poll_seconds": 2
    },
    "tensorboard": {
      "enabled": false,
      "log_dir": "checkpoints\\tb_runs",
      "run_name": "",
      "log_every": 10,
      "flush_secs": 5
    },
    "tqdm": {
      "ncols": 120,
      "dynamic_ncols": false
    },
    "data_sanity_check": {
      "enabled": false,
      "absmean_threshold": 10.0,
      "max_threshold": 10.0,
      "print_once": true,
      "auto_fix": false,
      "fix_mode": "0_255_to_minus1_1"
    },
    "grad": {
      "clip_max_norm": 1.0,
      "skip_norm_threshold": 0.0,
      "skip_on_nonfinite_loss": true
    },
    "filter_wo_decode": {
      "keep_percentile": 80,
      "safety_keep_ratio": 0.5,
      "monitor": {
        "enabled": true,
        "ratio": 0.1,
        "num_pairs": 256,
        "style_a": 0,
        "style_b": 1,
        "min_threshold": 0.0,
        "allow_empty": false,
        "seed": 1234
      }
    },
    "filter_w_decode": {
      "warmup_count": 32,
      "warmup_percentile": 80,
      "safety_keep_ratio": 0.5,
      "batch_size": 2,
      "use_fp16": true,
      "use_vae_slicing": true,
      "use_vae_tiling": true,
      "use_checkpointing": false,
      "decode_chunk_size": 1,
      "lpips_net": "alex",
      "fallback_threshold": 0.5,
      "monitor": {
        "enabled": true,
        "method": "lpips",
        "ratio": 0.1,
        "num_pairs": 128,
        "batch_size": 8,
        "style_a": 0,
        "style_b": 1,
        "min_threshold": 0.0,
        "allow_empty": false,
        "seed": 1234
      }
    },
    "stage2_sampler": {
      "enabled": true
    }
  },
  "data": {
    "data_root": "D:\\000college\\1cs\\3projects\\CycleGAN\\datasets\\monet2photo_pt",
    "num_classes": 2
  },
  "checkpoint": {
    "save_dir": "checkpoints"
  },
  "verify": {
    "checkpoint_path": "E:\\腾飞科创\\0117afternoonver\\checkpoints\\stage1_epoch20_raw.pt",
    "save_dir": "verify_outputs",
    "seed": 2026,
    "num_steps": 20,
    "cfg_scale": 1.0,
    "sample_index": -1,
    "vae_fp16": true
  },
  "inference":{
    "image_path": "D:\\000college\\1cs\\3projects\\CycleGAN\\datasets\\monet2photo\\inf",
    "save_dir": "D:\\000college\\1cs\\3projects\\CycleGAN\\datasets\\monet2photo\\inference_results",
    "cfg_scale": 3.0
  }
}